  "stage7_cadence_notes": "Every report includes the latest verified Stage 7 disposition and its age. When upstream evidence (Stage 3 hypotheses / Stage 5 evidence / Stage 6 data version) changes, the report notes a delta refresh is warranted; the Friday post-close report warrants a full recovery + risk-overlay refresh. The heavy recovery run is bounded and executed out-of-band (never inside a scheduled 25-minute cycle): 'stage7_launch_in_cycle' stays false and no fifth scheduled task is ever created.",
  "retention": {
    "runtime_logs_days": 90,
    "reports_days": 365,
    "sent_email_manifests_days": 365,
    "immutable_research_packages": "never_auto_deleted",
    "credentials_in_retention": "never"
