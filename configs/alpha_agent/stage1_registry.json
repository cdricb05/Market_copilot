{
  "stage": "1",
  "config_name": "alpha_agent_stage1_registry",
  "config_version": 1,
  "description": "Pre-registered configuration for Alpha Agent Stage 1: the Unified Research Memory and Canonical Registry. RESEARCH MEMORY ONLY. READ ONLY with respect to every source root. No new alpha search, no backtest, no model execution, no LLM call, no network, no database. All generated data is written only under output_root; every source root is treated as immutable.",

  "safety": {
    "research_memory_only": true,
    "no_new_experiment": true,
    "no_backtest": true,
    "no_model_execution": true,
    "no_llm_call": true,
    "no_network_call": true,
    "no_gcp_call": true,
    "no_provider_call": true,
    "no_database_connection": true,
    "no_database_write": true,
    "no_source_mutation": true,
    "no_operational_ledger_mutation": true,
    "no_active_book_change": true,
    "no_orders": true,
    "no_automation": true,
    "writes_only_to_output_root": true
  },

  "hashing": {
    "full_hash_max_bytes": 268435456,
    "full_hash_algorithm": "sha256",
    "sampled_fingerprint_label": "PARTIAL_CONTENT_FINGERPRINT",
    "sampled_fingerprint_edge_bytes": 1048576,
    "read_chunk_bytes": 4194304
  },

  "parsing": {
    "row_count_max_bytes": 134217728,
    "csv_column_sniff_bytes": 65536,
    "jsonl_first_record_only_for_columns": true,
    "supported_structured_formats": ["json", "jsonl", "csv", "md", "txt", "toml", "yaml", "yml", "sqlite", "db", "parquet"],
    "code_formats": ["py"],
    "binary_or_unsupported_formats": ["pkl", "pickle", "npz", "npy", "zip", "gz", "pyc", "html", "htm", "png", "jpg", "jpeg", "pdf", "xlsx"]
  },

